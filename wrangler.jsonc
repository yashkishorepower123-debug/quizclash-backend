
{
  "name": "quizclash-backend",
  "main": "src/index.js",
  "compatibility_date": "2026-10-23",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "QuizRoom"
      }
    ]
  },
  "exports": {
    "QuizRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
